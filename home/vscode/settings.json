{
	"security.workspace.trust.untrustedFiles": "open",
	"settingsSync.ignoredExtensions": ["mikeebowen.ooxml-extension-pack"],
	"explorer": {
		"confirmDelete": false,
		"confirmDragAndDrop": false
	},
	"search.exclude": {
		"**/bower_components": true,
		"**/node_modules": true,
		"**/vendor": true,
		"**/.git": true
	},
	"git": {
		"autofetch": true,
		"confirmSync": false,
		"openRepositoryInParentFolders": "never"
	},
	"diffEditor": {
		"wordWrap": "off",
		"ignoreTrimWhitespace": false
	},
	"workbench": {
		"colorCustomizations": {
			"editorBracketHighlight.foreground1": "#5caeef",
			"editorBracketHighlight.foreground2": "#dfb976",
			"editorBracketHighlight.foreground3": "#c172d9",
			"editorBracketHighlight.foreground4": "#4fb1bc",
			"editorBracketHighlight.foreground5": "#97c26c",
			"editorBracketHighlight.foreground6": "#abb2c0",
			"editorBracketHighlight.unexpectedBracket.foreground": "#db6165"
		},
		"startupEditor": "none",
		"iconTheme": "file-icons",
		"colorTheme": "Alabaster Dark",
		"ecloseEmptyGroups": false,
		"tree.enableStickyScroll": true
	},
	"editor": {
		"accessibilitySupport": "off",
		"bracketPairColorization.enabled": true,
		"detectIndentation": false,
		"fontLigatures": "'ss01'",
		"fontSize": 14,
		"fontFamily": "'Victor Mono Nerd Font', Menlo, Monaco, 'Courier New', monospace",
		"fontWeight": "medium",
		"inlineSuggest.enabled": true,
		"insertSpaces": false,
		"semanticHighlighting.enabled": true,
		"suggest.preview": true,
		"tabSize": 4,
		"defaultFormatter": "esbenp.prettier-vscode",
		"formatOnSave": true,
		"rulers": [80],
		"wordWrap": "wordWrapColumn",
		"wrappingIndent": "same",
		"wordWrapColumn": 100,
		"stickyScroll.enabled": true,
		"tokenColorCustomizations": {
			"textMateRules": [
				{
					"scope": [
						"comment",
						"entity.name.type.class",
						"keyword",
						"constant",
						"storage.modifier",
						"storage.type.class.js"
					],
					"settings": {
						"fontStyle": "italic"
					}
				},
				{
					"scope": [
						"invalid",
						"keyword.operator",
						"constant.numeric.css",
						"keyword.other.unit.px.css",
						"constant.numeric.decimal.js",
						"constant.numeric.json"
					],
					"settings": {
						"fontStyle": "regular"
					}
				}
			]
		},
		"bracketPairColorization.independentColorPoolPerBracketType": true,
		"guides.bracketPairs": true
	},
	"intelephense.stubs": [
		"apache",
		"bcmath",
		"bz2",
		"calendar",
		"com_dotnet",
		"Core",
		"ctype",
		"curl",
		"date",
		"dba",
		"dom",
		"enchant",
		"exif",
		"FFI",
		"fileinfo",
		"filter",
		"fpm",
		"ftp",
		"gd",
		"gettext",
		"gmp",
		"hash",
		"iconv",
		"imap",
		"intl",
		"json",
		"ldap",
		"libxml",
		"mbstring",
		"meta",
		"mysqli",
		"oci8",
		"odbc",
		"openssl",
		"pcntl",
		"pcre",
		"PDO",
		"pdo_ibm",
		"pdo_mysql",
		"pdo_pgsql",
		"pdo_sqlite",
		"pgsql",
		"Phar",
		"posix",
		"pspell",
		"readline",
		"Reflection",
		"session",
		"shmop",
		"SimpleXML",
		"snmp",
		"soap",
		"sockets",
		"sodium",
		"SPL",
		"sqlite3",
		"standard",
		"superglobals",
		"sysvmsg",
		"sysvsem",
		"sysvshm",
		"tidy",
		"tokenizer",
		"xml",
		"xmlreader",
		"xmlrpc",
		"xmlwriter",
		"xsl",
		"Zend OPcache",
		"zip",
		"zlib",
		"wordpress"
	],
	"indentRainbow.colors": [
		"rgba(64,120,192,0.07)",
		"rgba(108,198,68,0.07)",
		"rgba(189,44,0,0.07)",
		"rgba(201,81,12,0.07)",
		"rgba(110,84,148,0.07)"
	],
	"shellcheck.customArgs": ["--external-sources"],
	"todo-tree": {
		"general": {
			"showIconsInsteadOfTagsInStatusBar": true,
			"tags": [
				"BUG",
				"HACK",
				"FIXME",
				"TODO",
				"XXX",
				"[ ]",
				"[x]",
				"[-]",
				"[>]"
			]
		},
		"tree": {
			"showBadges": true,
			"grouped": true
		},
		"highlights": {
			"defaultHighlight": {
				"type": "whole-line",
				"background": "#273143",
				"opacity": 0.2,
				"gutterIcon": true
			},
			"customHighlight": {
				"TODO": {
					"icon": "check-circle"
				},
				"NOTE": {
					"icon": "note"
				},
				"COMMENT": {
					"icon": "comment"
				},
				"FIXME": {
					"icon": "alert"
				},
				"BUG": {
					"icon": "bug"
				},
				"[ ]": {
					"icon": "check-circle",
					"iconColor": "white"
				},
				"[x]": {
					"icon": "check-circle-fill",
					"iconColor": "green"
				},
				"[-]": {
					"icon": "circle-slash",
					"iconColor": "red"
				},
				"[>]": {
					"icon": "arrow-right",
					"iconColor": "grey"
				}
			}
		}
	},
	"redhat.telemetry.enabled": false,
	"[python]": {
		"editor.formatOnType": true
	},
	"makefile": {
		"buildBeforeLaunch": false,
		"clearOutputBeforeBuild": false,
		"configureOnEdit": false
	},
	"application.shellEnvironmentResolutionTimeout": 30,
	"files.exclude": {
		"**/.git": false
	},
	"[php]": {
		"editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
	},
	"github.copilot.nextEditSuggestions.enabled": true,
	"workbench.editor.enablePreview": false,
	"workbench.editorAssociations": {
		"*.svg": "default"
	},
	"chat.viewSessions.orientation": "stacked",
	"workbench.colorTheme": "Alabaster Dark"
}
