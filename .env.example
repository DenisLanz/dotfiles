# .env — machine-specific environment variables
# Copy this file to .env and fill in your values.
# .env is not tracked by git (see local/ for other machine-specific overrides).
#
# This file is sourced automatically by scripts/_utils and lib/shortcuts.zsh.

# ---------------------------------------------------------------------------
# Directory shortcuts
# ---------------------------------------------------------------------------
# SHORTCUTS is an associative array of name=path pairs.
# Each entry creates a shell alias that cds to that directory.
# Example: typing 'work' in the shell will run 'cd /path/to/work'.
#
typeset -A SHORTCUTS
SHORTCUTS=(
	# work    "/path/to/work"
	# clients "/path/to/clients"
	# dev     "$HOME/Developer"
)
